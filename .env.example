# Elige UNA de estas dos opciones para ver la ciudad en 3D fotorrealista.
# Sin ninguna, FlyFly usa ortofoto gratuita (PNOA del IGN en España + Sentinel-2 en el resto) sin relieve.

# Opción A (recomendada, gratis sin tarjeta): token de Cesium ion -> https://ion.cesium.com/tokens
# Da acceso a Google Photorealistic 3D Tiles a través de Cesium ion.
VITE_CESIUM_ION_TOKEN=

# Opción B: clave de Google Maps Platform con "Map Tiles API" activada (cuota gratuita mensual, requiere cuenta de facturación).
VITE_GOOGLE_MAPS_API_KEY=

# Idioma de Wikipedia para los lugares de interés.
VITE_WIKI_LANG=es

# URL pública de la web, sin barra final (p. ej. https://flyfly.es). Activa canonical, Open Graph y sitemap.
VITE_SITE_URL=

# Publicidad (opcional). Déjalo vacío para no mostrar anuncios. Ver docs/LANZAMIENTO.md.
VITE_ADSENSE_CLIENT=
VITE_ADSENSE_SLOT_FICHA=

# Edición para un ayuntamiento: id de public/ciudades/<id>.json (p. ej. coruna). Vacío: edición general.
VITE_CIUDAD=

# Estadísticas anónimas sin cookies (opcional, rellena solo una). Ver docs/LANZAMIENTO.md.
VITE_UMAMI_ID=
VITE_PLAUSIBLE_DOMAIN=
VITE_CF_BEACON=

# Servicio de formularios que recibe las solicitudes de la página Anúnciate (p. ej. https://formspree.io/f/xxxx).
# Vacío: la página ofrece enviar la solicitud por email y descargarla con las fotos.
VITE_FORM_ENDPOINT=
