# Elige UNA de estas dos opciones para ver la ciudad en 3D fotorrealista.
# Sin ninguna, FlyFly usa ortofoto gratuita (PNOA del IGN en España + Sentinel-2 en el resto) sin relieve.

# Opción A (recomendada, gratis sin tarjeta): token de Cesium ion -> https://ion.cesium.com/tokens
# Da acceso a Google Photorealistic 3D Tiles a través de Cesium ion.
VITE_CESIUM_ION_TOKEN=

# Opción B: clave de Google Maps Platform con "Map Tiles API" activada (cuota gratuita mensual, requiere cuenta de facturación).
VITE_GOOGLE_MAPS_API_KEY=

# Idioma de Wikipedia para los lugares de interés.
VITE_WIKI_LANG=es
